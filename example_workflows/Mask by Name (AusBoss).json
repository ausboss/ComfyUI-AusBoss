      },
      "widgets_values": [
        "{\"v\":1,\"title\":\"Mask by Name\",\"subtitle\":\"Type what to find in a picture. Get its mask and a cut-out, with nothing to paint.\",\"author\":\"AusBoss\",\"layout\":\"card\",\"accent\":\"\",\"body\":\"1. Load your picture.\\n2. In **Find**, type the thing in a few plain words, like \\\"the dog\\\" or \\\"the red jacket\\\".\\n3. Press **FIND** on Mask by Name. Only that node runs, and what it found turns teal.\\n4. Press **Run** to save the cut-out and the mask.\\n\\n### Good to know\\n\\n- When nothing is found, the run stops with a message, so nothing is saved by mistake.\\n- Several things at once: put a comma between them, \\\"the hat, the bag\\\".\\n- A small thing is missed? Open **More** and lower **Sureness** to 0.6.\\n- Switch a result off under **What to save** to skip it.\\n- The cut-out is a PNG with a see-through background.\\n\\nNeeds AusBoss nodes 2.7.0 or newer and ComfyUI 0.20 or newer, which has SAM 3 built in.\",\"models\":[{\"name\":\"sam3.1_multiplex_fp16.safetensors\",\"dir\":\"checkpoints\",\"size\":\"1.75 GB\",\"url\":\"https://huggingface.co/Comfy-Org/sam3.1/resolve/main/checkpoints/sam3.1_multiplex_fp16.safetensors\",\"note\":\"by Meta, packaged by Comfy-Org\"}],\"packs\":[{\"name\":\"ComfyUI-AusBoss\",\"url\":\"https://github.com/ausboss/ComfyUI-AusBoss\",\"node\":\"AUSBOSS_NODES_MaskByName\"}],\"links\":[{\"label\":\"GitHub · ausboss\",\"url\":\"https://github.com/ausboss\"},{\"label\":\"Civitai · AusBoss\",\"url\":\"https://civitai.com/user/AusBoss\"},{\"label\":\"X · Zanzibased\",\"url\":\"https://x.com/Zanzibased\"}]}"
      ],
      "widgets_values_named": {
        "note": "{\"v\":1,\"title\":\"Mask by Name\",\"subtitle\":\"Type what to find in a picture. Get its mask and a cut-out, with nothing to paint.\",\"author\":\"AusBoss\",\"layout\":\"card\",\"accent\":\"\",\"body\":\"1. Load your picture.\\n2. In **Find**, type the thing in a few plain words, like \\\"the dog\\\" or \\\"the red jacket\\\".\\n3. Press **FIND** on Mask by Name. Only that node runs, and what it found turns teal.\\n4. Press **Run** to save the cut-out and the mask.\\n\\n### Good to know\\n\\n- When nothing is found, the run stops with a message, so nothing is saved by mistake.\\n- Several things at once: put a comma between them, \\\"the hat, the bag\\\".\\n- A small thing is missed? Open **More** and lower **Sureness** to 0.6.\\n- Switch a result off under **What to save** to skip it.\\n- The cut-out is a PNG with a see-through background.\\n\\nNeeds AusBoss nodes 2.7.0 or newer and ComfyUI 0.20 or newer, which has SAM 3 built in.\",\"models\":[{\"name\":\"sam3.1_multiplex_fp16.safetensors\",\"dir\":\"checkpoints\",\"size\":\"1.75 GB\",\"url\":\"https://huggingface.co/Comfy-Org/sam3.1/resolve/main/checkpoints/sam3.1_multiplex_fp16.safetensors\",\"note\":\"by Meta, packaged by Comfy-Org\"}],\"packs\":[{\"name\":\"ComfyUI-AusBoss\",\"url\":\"https://github.com/ausboss/ComfyUI-AusBoss\",\"node\":\"AUSBOSS_NODES_MaskByName\"}],\"links\":[{\"label\":\"GitHub · ausboss\",\"url\":\"https://github.com/ausboss\"},{\"label\":\"Civitai · AusBoss\",\"url\":\"https://civitai.com/user/AusBoss\"},{\"label\":\"X · Zanzibased\",\"url\":\"https://x.com/Zanzibased\"}]}"
      },
