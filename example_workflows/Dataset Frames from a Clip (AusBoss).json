        "ver": "2.1.0",
        "Node name for S&R": "AUSBOSS_NODES_WorkflowNote"
      },
      "widgets_values": [
        "{\"v\":1,\"title\":\"Dataset Frames from a Clip\",\"subtitle\":\"Pull evenly spaced frames from a video, give them one size and save each with a caption file. No models needed.\",\"author\":\"AusBoss\",\"layout\":\"card\",\"accent\":\"\",\"body\":\"## Start here\\nCopy `ausboss_pier_9x16.mp4` from the pack's `example_workflows/inputs/` folder into `ComfyUI/input/`, or choose your own clip in Load Video, and queue. No models or extra node packs.\\n\\n## What happens\\n1. **Load Video** decodes the clip: all 97 frames of the sample. Drag the IN and OUT handles under the preview to use part of a longer clip.\\n2. **Select Every Nth** keeps frames 1, 13, 25 … 97: nine frames spread across the shot.\\n3. **Image Resize** scales the shortest edge to 768 px, and **Align Image** center-crops the long edge to a multiple of 64. Every frame comes out 768 × 1344.\\n4. **Save Image** writes `pier_dataset_768x1344_00001.png` onward: the **Size** and **Counter** tags build the names, and the workflow is left out of the files. The **Text** caption arrives on `caption_text`, so every PNG gets a `.txt` with the same name.\\n5. **Image Size** measures the saved batch, and three core **Preview as Text** nodes show its width, height and count (Show Text takes text only). **Show Text** displays the path of the first file written.\\n\\n## Try\\n- More or fewer frames: change **Every nth** on Select Every Nth; 6 keeps 17 frames.\\n- Start the caption with your trigger word, then describe what changes between shots.\\n- Collect a set in its own folder: type a subfolder such as `datasets/pier` in Save Image's **Folder** field.\",\"models\":[],\"packs\":[],\"links\":[{\"label\":\"Sample clip · ausboss_pier_9x16.mp4\",\"url\":\"https://raw.githubusercontent.com/ausboss/ComfyUI-AusBoss/main/example_workflows/inputs/ausboss_pier_9x16.mp4\"}]}",
        ""
      ],
      "widgets_values_named": {
        "note": "{\"v\":1,\"title\":\"Dataset Frames from a Clip\",\"subtitle\":\"Pull evenly spaced frames from a video, give them one size and save each with a caption file. No models needed.\",\"author\":\"AusBoss\",\"layout\":\"card\",\"accent\":\"\",\"body\":\"## Start here\\nCopy `ausboss_pier_9x16.mp4` from the pack's `example_workflows/inputs/` folder into `ComfyUI/input/`, or choose your own clip in Load Video, and queue. No models or extra node packs.\\n\\n## What happens\\n1. **Load Video** decodes the clip: all 97 frames of the sample. Drag the IN and OUT handles under the preview to use part of a longer clip.\\n2. **Select Every Nth** keeps frames 1, 13, 25 … 97: nine frames spread across the shot.\\n3. **Image Resize** scales the shortest edge to 768 px, and **Align Image** center-crops the long edge to a multiple of 64. Every frame comes out 768 × 1344.\\n4. **Save Image** writes `pier_dataset_768x1344_00001.png` onward: the **Size** and **Counter** tags build the names, and the workflow is left out of the files. The **Text** caption arrives on `caption_text`, so every PNG gets a `.txt` with the same name.\\n5. **Image Size** measures the saved batch, and three core **Preview as Text** nodes show its width, height and count (Show Text takes text only). **Show Text** displays the path of the first file written.\\n\\n## Try\\n- More or fewer frames: change **Every nth** on Select Every Nth; 6 keeps 17 frames.\\n- Start the caption with your trigger word, then describe what changes between shots.\\n- Collect a set in its own folder: type a subfolder such as `datasets/pier` in Save Image's **Folder** field.\",\"models\":[],\"packs\":[],\"links\":[{\"label\":\"Sample clip · ausboss_pier_9x16.mp4\",\"url\":\"https://raw.githubusercontent.com/ausboss/ComfyUI-AusBoss/main/example_workflows/inputs/ausboss_pier_9x16.mp4\"}]}",
        "ausboss_workflow_note_panel": ""
      },
      "color": "#14424d",
      "bgcolor": "#161f21"
    },
