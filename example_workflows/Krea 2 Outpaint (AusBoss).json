    {
      "id": 17,
      "type": "AUSBOSS_NODES_WorkflowNote",
      "pos": [
        -1680,
        100
      ],
      "size": [
        560,
        1060
      ],
      "flags": {},
      "order": 17,
      "mode": 0,
