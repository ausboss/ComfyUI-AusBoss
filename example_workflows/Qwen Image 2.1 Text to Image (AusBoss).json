        "ver": "2.0.2",
        "Node name for S&R": "AUSBOSS_NODES_WorkflowNote"
      },
      "widgets_values": [
        "{\"v\":1,\"title\":\"Qwen Image 2.1 Text to Image\",\"subtitle\":\"Your prompt, your canvas, an optional LoRA stack. A clear path from text to PNG.\",\"author\":\"AusBoss\",\"layout\":\"card\",\"accent\":\"#69b9c4\",\"body\":\"## Start here\\nDownload the three files below into the named folders under `ComfyUI/models/`. Refresh the model list, select them in the loaders, write a prompt and queue. Requires ComfyUI with **Text Encode Qwen Image 2.1**.\\n\\n## Make it yours\\n1. **LoRA Loader** starts empty. Add only adapters made for Qwen Image 2.1; selected trigger words join your text automatically.\\n2. **Resolution Master** picks the canvas. Its width and height drive the core empty latent. Keep the 32-pixel snap; start at 1024 × 1024, or try 2048 × 2048 for a larger render.\\n3. **Text** holds your description. **Qwen Encode** handles positive and negative conditioning together.\\n4. **Seed** starts fixed for repeatable comparisons. Switch to Random for variations. **Save Image** writes a PNG with this workflow inside.\\n\\n## Sampling\\n25 steps, CFG 1, Euler / simple, denoise 1. These starting values match the supplied template. Try 40 steps for a more complete render. Negative text has no effect at CFG 1.\\n\\n## Transparent output\\nAsk explicitly for an RGBA image, a transparent background and an alpha channel. Keep PNG selected so transparency survives saving.\\n\\n## Models\\nThe buttons below download the selected INT8 pair and the 2.1 VAE. BF16 alternatives are linked on the model repository. If files are in subfolders, select those paths in the loaders.\",\"models\":[{\"name\":\"qwen_image_2.1_int8_convrot.safetensors\",\"dir\":\"diffusion_models\",\"size\":\"7.26 GB\",\"note\":\"Selected INT8 diffusion model.\",\"url\":\"https://huggingface.co/Comfy-Org/Qwen-Image-2.1/resolve/main/diffusion_models/qwen_image_2.1_int8_convrot.safetensors\"},{\"name\":\"qwen3vl_8b_int8_convrot.safetensors\",\"dir\":\"text_encoders\",\"size\":\"9.35 GB\",\"note\":\"Selected Qwen3-VL 8B encoder; CLIP type: qwen_image.\",\"url\":\"https://huggingface.co/Comfy-Org/Qwen-Image-2.1/resolve/main/text_encoders/qwen3vl_8b_int8_convrot.safetensors\"},{\"name\":\"qwen_image_2.1_vae_bf16.safetensors\",\"dir\":\"vae\",\"size\":\"676 MB\",\"note\":\"Use the Qwen Image 2.1 VAE.\",\"url\":\"https://huggingface.co/Comfy-Org/Qwen-Image-2.1/resolve/main/vae/qwen_image_2.1_vae_bf16.safetensors\"}],\"packs\":[],\"links\":[{\"label\":\"Qwen 2.1 model files + BF16 alternatives\",\"url\":\"https://huggingface.co/Comfy-Org/Qwen-Image-2.1\"},{\"label\":\"Qwen model guide\",\"url\":\"https://huggingface.co/Qwen/Qwen-Image-2.1\"}]}",
        ""
      ],
      "widgets_values_named": {
        "note": "{\"v\":1,\"title\":\"Qwen Image 2.1 Text to Image\",\"subtitle\":\"Your prompt, your canvas, an optional LoRA stack. A clear path from text to PNG.\",\"author\":\"AusBoss\",\"layout\":\"card\",\"accent\":\"#69b9c4\",\"body\":\"## Start here\\nDownload the three files below into the named folders under `ComfyUI/models/`. Refresh the model list, select them in the loaders, write a prompt and queue. Requires ComfyUI with **Text Encode Qwen Image 2.1**.\\n\\n## Make it yours\\n1. **LoRA Loader** starts empty. Add only adapters made for Qwen Image 2.1; selected trigger words join your text automatically.\\n2. **Resolution Master** picks the canvas. Its width and height drive the core empty latent. Keep the 32-pixel snap; start at 1024 × 1024, or try 2048 × 2048 for a larger render.\\n3. **Text** holds your description. **Qwen Encode** handles positive and negative conditioning together.\\n4. **Seed** starts fixed for repeatable comparisons. Switch to Random for variations. **Save Image** writes a PNG with this workflow inside.\\n\\n## Sampling\\n25 steps, CFG 1, Euler / simple, denoise 1. These starting values match the supplied template. Try 40 steps for a more complete render. Negative text has no effect at CFG 1.\\n\\n## Transparent output\\nAsk explicitly for an RGBA image, a transparent background and an alpha channel. Keep PNG selected so transparency survives saving.\\n\\n## Models\\nThe buttons below download the selected INT8 pair and the 2.1 VAE. BF16 alternatives are linked on the model repository. If files are in subfolders, select those paths in the loaders.\",\"models\":[{\"name\":\"qwen_image_2.1_int8_convrot.safetensors\",\"dir\":\"diffusion_models\",\"size\":\"7.26 GB\",\"note\":\"Selected INT8 diffusion model.\",\"url\":\"https://huggingface.co/Comfy-Org/Qwen-Image-2.1/resolve/main/diffusion_models/qwen_image_2.1_int8_convrot.safetensors\"},{\"name\":\"qwen3vl_8b_int8_convrot.safetensors\",\"dir\":\"text_encoders\",\"size\":\"9.35 GB\",\"note\":\"Selected Qwen3-VL 8B encoder; CLIP type: qwen_image.\",\"url\":\"https://huggingface.co/Comfy-Org/Qwen-Image-2.1/resolve/main/text_encoders/qwen3vl_8b_int8_convrot.safetensors\"},{\"name\":\"qwen_image_2.1_vae_bf16.safetensors\",\"dir\":\"vae\",\"size\":\"676 MB\",\"note\":\"Use the Qwen Image 2.1 VAE.\",\"url\":\"https://huggingface.co/Comfy-Org/Qwen-Image-2.1/resolve/main/vae/qwen_image_2.1_vae_bf16.safetensors\"}],\"packs\":[],\"links\":[{\"label\":\"Qwen 2.1 model files + BF16 alternatives\",\"url\":\"https://huggingface.co/Comfy-Org/Qwen-Image-2.1\"},{\"label\":\"Qwen model guide\",\"url\":\"https://huggingface.co/Qwen/Qwen-Image-2.1\"}]}",
        "ausboss_workflow_note_panel": ""
