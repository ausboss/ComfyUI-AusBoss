   "widgets_values": [
    "{\"v\": 1, \"title\": \"Mask by Touch\", \"subtitle\": \"Click a thing in your picture. Get its mask and a cut-out, with nothing to type or paint.\", \"author\": \"AusBoss\", \"layout\": \"card\", \"accent\": \"\", \"body\": \"[▶ AusBoss on YouTube](https://www.youtube.com/@ausbossdev) · videos on these nodes and workflows\\n\\n---\\n\\n1. Load your picture.\\n2. Move the pointer over it on **Mask by Touch**. Things light up and say their name.\\n3. **Click** a thing to pick it. Click more things to add them.\\n4. Press **Run** to save the cut-out and the mask.\\n\\n### Good to know\\n\\n- **Subject** takes the picture's main subject in one click. **Background** takes everything else.\\n- Wrong thing? The **‹ ›** arrows under the picture swap the pick for the next thing at that spot.\\n- **Paint** and **Erase** fix the mask by hand; hold **Ctrl** for the other one. Ctrl-click a thing to take it away, and **Undo** takes a step back.\\n- A thing that does not light up: type its name in the field under the picture.\\n- **Fine edges** is on: hair and fur come out strand by strand, and the cut-out carries no colour of the old background.\\n- The eye beside **Undo** and **Clear** hides everything else, so you see the result before you run.\\n- When nothing is picked, the run stops with a message, so nothing is saved by mistake.\\n- Switch a result off under **What to save** to skip it.\\n\\nNeeds AusBoss nodes 2.11.0 or newer and ComfyUI 0.21 or newer, which has SAM 3 and the background-removal model built in.\", \"models\": [{\"name\": \"sam3.1_multiplex_fp16.safetensors\", \"dir\": \"checkpoints\", \"size\": \"1.75 GB\", \"url\": \"https://huggingface.co/Comfy-Org/sam3.1/resolve/main/checkpoints/sam3.1_multiplex_fp16.safetensors\", \"note\": \"by Meta, packaged by Comfy-Org\"}, {\"name\": \"birefnet.safetensors\", \"dir\": \"background_removal\", \"size\": \"445 MB\", \"url\": \"https://huggingface.co/Comfy-Org/BiRefNet/resolve/main/background_removal/birefnet.safetensors\", \"note\": \"BiRefNet, packaged by Comfy-Org · for Subject, Background and Fine edges · MIT\"}], \"packs\": [{\"name\": \"ComfyUI-AusBoss\", \"url\": \"https://github.com/ausboss/ComfyUI-AusBoss\", \"node\": \"AUSBOSS_NODES_MaskByTouch\"}], \"links\": [{\"label\": \"YouTube · ausbossdev\", \"url\": \"https://www.youtube.com/@ausbossdev\"}, {\"label\": \"GitHub · ausboss\", \"url\": \"https://github.com/ausboss\"}, {\"label\": \"Civitai · AusBoss\", \"url\": \"https://civitai.com/user/AusBoss\"}, {\"label\": \"X · Zanzibased\", \"url\": \"https://x.com/Zanzibased\"}]}"
   ],
   "widgets_values_named": {
    "note": "{\"v\": 1, \"title\": \"Mask by Touch\", \"subtitle\": \"Click a thing in your picture. Get its mask and a cut-out, with nothing to type or paint.\", \"author\": \"AusBoss\", \"layout\": \"card\", \"accent\": \"\", \"body\": \"[▶ AusBoss on YouTube](https://www.youtube.com/@ausbossdev) · videos on these nodes and workflows\\n\\n---\\n\\n1. Load your picture.\\n2. Move the pointer over it on **Mask by Touch**. Things light up and say their name.\\n3. **Click** a thing to pick it. Click more things to add them.\\n4. Press **Run** to save the cut-out and the mask.\\n\\n### Good to know\\n\\n- **Subject** takes the picture's main subject in one click. **Background** takes everything else.\\n- Wrong thing? The **‹ ›** arrows under the picture swap the pick for the next thing at that spot.\\n- **Paint** and **Erase** fix the mask by hand; hold **Ctrl** for the other one. Ctrl-click a thing to take it away, and **Undo** takes a step back.\\n- A thing that does not light up: type its name in the field under the picture.\\n- **Fine edges** is on: hair and fur come out strand by strand, and the cut-out carries no colour of the old background.\\n- The eye beside **Undo** and **Clear** hides everything else, so you see the result before you run.\\n- When nothing is picked, the run stops with a message, so nothing is saved by mistake.\\n- Switch a result off under **What to save** to skip it.\\n\\nNeeds AusBoss nodes 2.11.0 or newer and ComfyUI 0.21 or newer, which has SAM 3 and the background-removal model built in.\", \"models\": [{\"name\": \"sam3.1_multiplex_fp16.safetensors\", \"dir\": \"checkpoints\", \"size\": \"1.75 GB\", \"url\": \"https://huggingface.co/Comfy-Org/sam3.1/resolve/main/checkpoints/sam3.1_multiplex_fp16.safetensors\", \"note\": \"by Meta, packaged by Comfy-Org\"}, {\"name\": \"birefnet.safetensors\", \"dir\": \"background_removal\", \"size\": \"445 MB\", \"url\": \"https://huggingface.co/Comfy-Org/BiRefNet/resolve/main/background_removal/birefnet.safetensors\", \"note\": \"BiRefNet, packaged by Comfy-Org · for Subject, Background and Fine edges · MIT\"}], \"packs\": [{\"name\": \"ComfyUI-AusBoss\", \"url\": \"https://github.com/ausboss/ComfyUI-AusBoss\", \"node\": \"AUSBOSS_NODES_MaskByTouch\"}], \"links\": [{\"label\": \"YouTube · ausbossdev\", \"url\": \"https://www.youtube.com/@ausbossdev\"}, {\"label\": \"GitHub · ausboss\", \"url\": \"https://github.com/ausboss\"}, {\"label\": \"Civitai · AusBoss\", \"url\": \"https://civitai.com/user/AusBoss\"}, {\"label\": \"X · Zanzibased\", \"url\": \"https://x.com/Zanzibased\"}]}"
   },
