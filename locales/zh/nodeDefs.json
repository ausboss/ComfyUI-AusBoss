  "AUSBOSS_NODES_StepPreview": {
    "display_name": "步骤预览 🆎",
    "description": "在图片生成过程中逐步显示画面，并带一个停止按钮。如果效果不对，可以提前停止，不用等到最后一步。放在任何地方都行：不需要连线，会显示工作流正在生成的内容。带这个节点的工作流会自己向 ComfyUI 请求步骤预览图，除非你已在 ComfyUI 设置里选了预览方式。"
  },
  "AUSBOSS_NODES_StitchInpaint": {
    "display_name": "局部重绘拼回 🆎",
    "description": "把局部重绘裁剪 🆎 的重绘结果，或加载图像 + 扩边 🆎、裁剪 + 旋转 + 扩边 🆎 节点的扩图画布，贴回原图。Seam 决定新区域怎么和原图衔接：classic（默认）使用 stitcher 中记录的羽化遮罩混合，和以前的工作流完全一样；blend in 在原图内侧一小段把模型生成的画面渐变融入，适合扩图，无论是否旋转。新区域比原图偏亮、偏暗或偏暖时，调高 color_match（色调匹配）。classic 在接缝两侧测量色差；blend in 在模型重画了原图边缘的地方测量，如果整条边缘的色差不一致就不改颜色。拼回没碰到的像素和原图逐位相同，不会经过缩放。由单张图生成的 stitcher 可以用于整个重绘帧批次。使用 classic 时，如果接缝出现暗边或亮边，打开 fix_edge_halo。blend_mask 输出标出拼回改动的区域，坐标就是拼回后的图像，可以直接接颜色匹配。在图像裁剪 + 旋转 + 扩边 🆎 里手动裁剪后，把 Paste onto 设为 original，就能拿回整张原图并带上修改。",
    "inputs": {
      "stitcher": {
        "name": "stitcher"
      },
      "inpainted": {
        "name": "重绘结果"
      },
      "fix_edge_halo": {
        "name": "修复边缘光晕"
      },
      "color_match": {
        "name": "色调匹配"
      },
      "seam": {
        "name": "接缝"
      },
      "paste_onto": {
        "name": "贴到"
      }
    },
    "outputs": {
      "0": {
        "name": "图像"
      },
      "1": {
        "name": "混合遮罩"
      }
    }
  },
