  "AUSBOSS_NODES_FreeMemory": {
    "display_name": "释放显存 🆎",
    "description": "让任意连线原样通过，并在途中卸载 ComfyUI 缓存的模型、清空 CUDA 缓存。把它放在一个吃显存的步骤和下一个步骤之间，下一步就能在显存空闲时开始，而不是报显存不足。每一步释放都是尽力而为：某个接口不存在或变了，就跳过那一步，连线照常通过。和其他节点一样，它只在输入变化时运行，所以不会破坏下游缓存。",
    "inputs": {
      "value": {
        "name": "值"
      }
    },
    "outputs": {
      "0": {
        "name": "值"
      }
    }
  },
