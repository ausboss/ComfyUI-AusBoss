{
  "AUSBOSS_NODES_AlignImage": {
    "display_name": "对齐图像 🆎",
    "description": "把图像的宽和高对齐到你选的整数倍，例如 8、16、32，按模型的要求来。Qwen 图像模型、VAE 和很多采样器在尺寸能整除时效果最好。resize 缩放到最接近的倍数，crop 从你选的锚点裁小到一个倍数，pad 用边缘像素或颜色扩大到一个倍数；新尺寸以 INT 输出，可以直接连到 latent 节点。",
    "inputs": {
      "image": {
        "name": "图像"
      },
      "multiple": {
        "name": "倍数"
      },
      "mode": {
        "name": "模式"
      },
      "crop_position": {
        "name": "裁剪位置"
      },
      "pad_position": {
        "name": "扩边位置"
      },
      "pad_fill": {
        "name": "扩边填充"
      },
      "pad_color": {
        "name": "扩边颜色"
      }
    },
    "outputs": {
      "0": {
        "name": "图像"
      },
      "1": {
        "name": "宽度"
      },
      "2": {
        "name": "高度"
      }
    }
  },
  "AUSBOSS_NODES_Callout": {
    "display_name": "标注 🆎",
    "description": "画布上的便签。写一两行字，文字会放大填满便签，不用放大画布也能看清。文字里的箭头表情会变成行内的青色箭头。双击编辑。它不参与运行：没有输入也没有输出。",
    "inputs": {
      "text": {
        "name": "文本"
      }
    }
  },
  "AUSBOSS_NODES_ColorMatch": {
    "display_name": "颜色匹配 🆎",
    "description": "把参考图的颜色统计转移到输入图上，用来修正局部重绘或拼回区域的色差。四种方法：lab 和 rgb 按通道调整均值和标准差，mkl 映射完整的颜色协方差，histogram 让每个通道的分布完全一致。可选的 mask 把测量和校正都限制在白色区域（invert_mask 反转），所以节点接收遮罩但不输出遮罩：遮罩只决定修正范围，在你的图中原样通过。strength 在原图和完全匹配的结果之间混合。视频用 reference_mode：first_frame 让每一帧都匹配批次自己的第一帧，不需要参考图也能减少帧间色彩漂移；它不会稳定画面运动。",
    "inputs": {
      "image": {
        "name": "图像"
      },
      "strength": {
        "name": "强度"
      },
      "reference": {
        "name": "参考"
      },
      "method": {
        "name": "方法"
      },
      "mask": {
        "name": "遮罩"
      },
      "invert_mask": {
        "name": "反转遮罩"
      },
      "reference_mode": {
        "name": "参考模式"
      }
    },
    "outputs": {
      "0": {
        "name": "图像"
      }
    }
  },
  "AUSBOSS_NODES_Compare": {
    "display_name": "图像对比 A/B 🆎",
    "description": "在一个面板上显示 A 和 B：在上面滑动，指针左边显示 B；也可以用图片下方的开关固定显示 A 或 B。擦除功能用画笔擦掉一张图的部分，让另一张露出来，并把混合结果存为 PNG，需要的话还能存分层 PSD 和遮罩。image_a 和 image_b 原样通过，所以节点可以放在图的中间。",
    "inputs": {
      "image_a": {
        "name": "图像 A"
      },
      "image_b": {
        "name": "图像 B"
      },
      "filename": {
        "name": "文件名"
      }
    },
    "outputs": {
      "0": {
        "name": "图像 A"
      },
      "1": {
        "name": "图像 B"
      }
    }
  },
  "AUSBOSS_NODES_CropForInpaint": {
    "display_name": "局部重绘裁剪 🆎",
    "description": "把遮罩区域连同周围的上下文从图像中裁出来，让重绘模型以原生分辨率工作，并输出一个 stitcher，局部重绘拼回 🆎 用它把结果无缝贴回去。选区可以反转、扩大或缩小，并在裁剪前柔化边缘；上下文由扩张系数加可选的固定像素决定，并止于图片边缘，除非关闭 keep_inside。target_megapixels 把裁剪区域缩放到适合采样器的面积，extend 系列输入可以扩大画框用于扩图。默认情况下采样遮罩保持硬边；羽化放在单独的混合遮罩里，只在拼回时使用。空遮罩会选中整张图，拼回时不做改动。",
    "inputs": {
      "image": {
        "name": "图像"
      },
      "mask": {
        "name": "遮罩"
      },
      "context_factor": {
        "name": "上下文系数"
      },
      "blend_pixels": {
        "name": "混合像素"
      },
      "output_multiple": {
        "name": "输出倍数"
      },
      "target_width": {
        "name": "目标宽度"
      },
      "target_height": {
        "name": "目标高度"
      },
      "mask_grow": {
        "name": "遮罩扩大"
      },
      "mask_blur": {
        "name": "遮罩模糊"
      },
      "invert_mask": {
        "name": "反转遮罩"
      },
      "context_pixels": {
        "name": "上下文像素"
      },
      "target_megapixels": {
        "name": "目标百万像素"
      },
      "rescale_algorithm": {
        "name": "缩放算法"
      },
      "extend_left": {
        "name": "向左扩展"
      },
      "extend_right": {
        "name": "向右扩展"
      },
      "extend_up": {
        "name": "向上扩展"
      },
      "extend_down": {
        "name": "向下扩展"
      },
      "keep_inside": {
        "name": "保持在图内"
      }
    },
    "outputs": {
      "0": {
        "name": "图像"
      },
      "1": {
        "name": "遮罩"
      },
      "2": {
        "name": "stitcher"
      }
    }
  },
  "AUSBOSS_NODES_EditLock": {
    "display_name": "编辑锁定 🆎",
    "description": "让图片里编辑没有改动的部分保持在原位，颜色也不变。编辑模型会把整张图重画一遍，没改的部分常常略微放大、偏移或偏色。把这个节点放在模型和采样器之间，并接上你要编辑的图片。不需要遮罩：它在出图过程中看出编辑改了哪里。如果编辑改变的是整张图（新风格、新光线、新天气），它会自动让开。解码后再接上编辑锁定还原 🆎，未改动的部分就能换回你原图的像素。",
    "inputs": {
      "model": {
        "name": "模型"
      },
      "vae": {
        "name": "vae"
      },
      "image": {
        "name": "图像"
      },
      "lock": {
        "name": "锁定"
      },
      "tolerance": {
        "name": "容差"
      },
      "mask": {
        "name": "遮罩"
      }
    },
    "outputs": {
      "0": {
        "name": "模型"
      },
      "1": {
        "name": "编辑锁"
      }
    }
  },
  "AUSBOSS_NODES_EditLockRestore": {
    "display_name": "编辑锁定还原 🆎",
    "description": "把编辑没有改动的部分换回你原图自己的像素。放在 VAE 解码之后，并接上编辑锁定 🆎 的 edit_lock 输出。未改动的部分与原图逐像素一致，只有编辑的部分是新的。如果锁定让开了，图片原样通过。",
    "inputs": {
      "image": {
        "name": "图像"
      },
      "edit_lock": {
        "name": "编辑锁"
      },
      "feather": {
        "name": "羽化"
      }
    },
    "outputs": {
      "0": {
        "name": "图像"
      },
      "1": {
        "name": "编辑遮罩"
      },
      "2": {
        "name": "报告"
      }
    }
  },
